{
  "name": "@appraiseme/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable presentation components",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
