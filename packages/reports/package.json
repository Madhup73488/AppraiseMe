{
  "name": "@appraiseme/reports",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Report generation and domain formatting",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@appraiseme/ai-core": "workspace:*",
    "@appraiseme/contracts": "workspace:*",
    "@appraiseme/domain": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
